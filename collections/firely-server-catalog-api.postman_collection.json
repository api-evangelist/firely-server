      "item": [
        {
          "id": "b618a4b1-587d-4ab7-8366-f5bcf0b4bf03",
          "name": "Search FHIR packages",
          "request": {
            "name": "Search FHIR packages",
            "description": {
              "content": "Search for FHIR packages by name, canonical and other attributes.\n* Can be used for populating intellisense dropdowns for package search.\n* Does not intend to follow NPM in all aspects and adds extra FHIR specific searches, like canonicals and FHIR versions.\n\nKnown limitations:\n* Packages from which all versions are marked as `unlisted` are not returned.\n* The attribute names of the return value are documented here as camelCase, but are in fact currently PascalCase.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "catalog"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "name",
                  "value": "<string>",
                  "description": "Search by (part of) a package name"
                },
                {
                  "disabled": false,
                  "key": "version",
                  "value": "<string>",
                  "description": "Search for packages with a version containing this term"
                },
                {
                  "disabled": false,
                  "key": "canonical",
                  "value": "<string>",
                  "description": "Search for packages or resource contained in it with this term in their canonical"
                },
                {
                  "disabled": false,
                  "key": "pkgcanonical",
                  "value": "<string>",
                  "description": "Search for packages with this exact canonical"
                },
                {
                  "disabled": false,
                  "key": "fhirVersion",
                  "value": "<string>",
                  "description": "Limit search by FHIR version"
                },
                {
                  "disabled": false,
                  "key": "prerelease",
                  "value": "false",
                  "description": "Whether to include or exclude prerelease package versions"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "414b5997-a340-486f-957e-933f8055c730",
              "name": "A list of package objects",
              "originalRequest": {
                "url": {
